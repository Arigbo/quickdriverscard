# Public URL used for canonical links, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://quickdriverscard.vercel.app

# Driver's licence checks (FRSC) via Dojah. Leave empty to use simulated checks.
# Sandbox: https://sandbox.dojah.io · Live: https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io

# Plate number / registration checks (NVIS) via Prembly. Leave empty to simulate.
PREMBLY_APP_ID=
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_PLATE_PATH=/identitypass/verification/vehicle
